{
  "name": "burst-guard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "爆裂攻城 — mobile artillery siege duel (Phaser 3 + TypeScript + Vite)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "qa": "node tools/qa-playthrough.mjs",
    "qa:ai": "vite-node tools/ai-selfplay.ts",
    "verify": "tsc --noEmit && vitest run && vite build",
    "build:single": "node tools/build-single-html.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "playwright-core": "^1.64.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "game",
    "phaser",
    "typescript",
    "vite",
    "artillery",
    "mobile",
    "html5"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/REPLACE_ME/burst-guard.git"
  }
}
